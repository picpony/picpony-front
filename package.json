{
  "name": "picpony-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "node --test scripts/testResources.mjs scripts/testSessionAndTags.mjs scripts/repairSecurityTest.mjs scripts/testDataBoundaries.mjs scripts/testPageFlows.mjs scripts/testGlossaryFlows.mjs scripts/testSanitizeHtml.mjs scripts/testApiTransport.mjs scripts/testAdminConsistency.mjs scripts/testPageConsistency.mjs scripts/testCoreConsistency.mjs",
    "test:ui": "node scripts/reviewUiTest.mjs",
    "test:sanitize": "node scripts/testSanitizeHtml.mjs",
    "test:browser": "node scripts/reviewBrowser.mjs",
    "test:overlays": "node scripts/repairOverlayTest.mjs",
    "test:security": "node scripts/repairSecurityTest.mjs --browser",
    "test:favorites": "node scripts/testFavorites.mjs",
    "icons": "node scripts/pwaIcons.mjs",
    "colors": "node scripts/palette.mjs",
    "colors:write": "node scripts/palette.mjs --write",
    "hero:path": "node scripts/heroPath.mjs",
    "net:audit": "node scripts/netAudit.mjs",
    "net:scroll": "node scripts/netAuditScroll.mjs",
    "net:tabs": "node scripts/netAuditTabHeight.mjs",
    "net:tabnav": "node scripts/netAuditTabNav.mjs",
    "perf:weight": "node scripts/probeWeight.mjs",
    "perf:metrics": "node scripts/probeMetrics.mjs",
    "perf:hydration": "node scripts/probeHydration.mjs",
    "perf:motion": "node scripts/probeMotion.mjs",
    "perf:sw": "node scripts/probeServiceWorker.mjs",
    "perf:ripple": "node scripts/probeRipple.mjs",
    "perf:glass": "node scripts/probeFlutedGlass.mjs",
    "perf:pageturn": "node scripts/probePageTurn.mjs",
    "perf:sharpness": "node scripts/probeHeroSharpness.mjs",
    "perf:sharpness:warm": "node scripts/probeHeroSharpness.mjs 1920 --fake-cdn"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@material/material-color-utilities": "0.3.0",
    "@wangeditor/editor": "^5.1.23",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "next": "16.3.3",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.1",
    "unified": "11.0.5",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
